# Claude API key — server-side only. Read in src/app/api/transcribe/route.ts.
# Generate a key in the Anthropic console and paste it here as .env.local.
# NEVER commit the real key. NEVER prefix it with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-...

# Google Cloud Translation API key — server-side only.
# Read in src/app/api/translate/route.ts. Enable the "Cloud Translation API"
# in a Google Cloud project, create an API key, and paste it here.
# NEVER commit the real key. NEVER prefix it with NEXT_PUBLIC_.
GOOGLE_TRANSLATE_API_KEY=...
